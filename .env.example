# ==============================================================================
# Autonomous AI Viral Reels & YouTube Shorts Automation Platform Configuration
# ==============================================================================

# System Environment
APP_ENV=development
APP_NAME="Autonomous AI Reels & Shorts Automation Engine"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration
# Default to SQLite for easy local execution; use PostgreSQL for cloud deployment
DATABASE_URL="sqlite+aiosqlite:///./data/automation.db"
# Example PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/viral_reels_db

# Storage & Zero-Waste Lifecycle Policy
STORAGE_PROVIDER="local"  # "local", "gcs", or "s3"
GCS_BUCKET_NAME="viral-reels-prod-bucket"
LOCAL_STORAGE_DIR="./data/media"
# If true, scenes and intermediate renders are purged immediately after dual-platform verified upload
AUTO_CLEANUP_AFTER_UPLOAD=true
# Fallback retention days for final published videos (0 = immediate purge)
FINAL_VIDEO_RETENTION_DAYS=0

# AI Core: Google Gemini API (Scriptwriting, Strategy, Storyboarding)
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# AI Video Generation: Google Flow / Veo 2
# Set VEO_SIMULATION_MODE=false to invoke live Google Veo endpoints
VEO_SIMULATION_MODE=true
GOOGLE_GENAI_API_KEY="your-google-genai-api-key"
VEO_MODEL="veo-2.0-generate-001"
VEO_PROJECT_ID="your-gcp-project-id"
VEO_LOCATION="us-central1"
# Optional Google Flow Studio automation webhook/token if using private Flow instance
GOOGLE_FLOW_ENDPOINT=""
GOOGLE_FLOW_API_KEY=""

# AI Audio & Voiceover Engine
TTS_PROVIDER="edge-tts"  # "edge-tts", "elevenlabs", or "google-cloud"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Meta Instagram Graph API (Reels Publishing)
# Requires an Instagram Professional (Creator or Business) Account linked to a Facebook Page
INSTAGRAM_ACCOUNT_ID="your-instagram-business-account-id"
INSTAGRAM_ACCESS_TOKEN="your-long-lived-page-access-token"
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"

# Google YouTube Data API v3 (Shorts Publishing)
YOUTUBE_CLIENT_ID="your-youtube-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_REFRESH_TOKEN="your-oauth2-refresh-token"
YOUTUBE_CHANNEL_ID="your-youtube-channel-id"

# Autonomous Pipeline & Approval Controls
# Enforce human approval by default before publishing as requested in Section 16
REQUIRE_MANUAL_APPROVAL=true
DEFAULT_VIDEO_DURATION_SECONDS=45
TARGET_ASPECT_RATIO="9:16"
TARGET_RESOLUTION_WIDTH=1080
TARGET_RESOLUTION_HEIGHT=1920

# Automation Cron Schedules (Configurable)
TREND_RESEARCH_INTERVAL_HOURS=6
CONTENT_PLANNING_CRON="0 8 * * *"     # 8:00 AM daily
PUBLISHING_CRON="0 18 * * *"          # 6:00 PM daily
ANALYTICS_CRON="0 23 * * *"           # 11:00 PM daily
WEEKLY_REPORT_CRON="0 10 * * 0"       # 10:00 AM Sunday
